# ───── Staging (copia de pruebas) · variables de la app ─────
# Copia a .env.staging en /opt/inventory_staging y completa. NUNCA pongas aquí las
# conexiones de producción: staging solo habla con inventory_db_staging.

DATABASE_URL_VE=postgresql://postgres:MISMA_CLAVE_QUE_STAGING_DB_PASSWORD@inventory_db_staging:5432/inventory_ve
DATABASE_URL_CO=postgresql://postgres:MISMA_CLAVE_QUE_STAGING_DB_PASSWORD@inventory_db_staging:5432/inventory_co

# Secret DISTINTO al de producción (openssl rand -base64 32): así una sesión de un
# sitio no sirve en el otro.
NEXTAUTH_SECRET=PEGA_AQUI_UN_SECRET_NUEVO
NEXTAUTH_URL=https://staging.elcomerciantedigital.com

NEXT_PUBLIC_APP_NAME=Syncsora Inventory (staging)
DOLAR_API_URL=https://ve.dolarapi.com/v1/dolares
# Distinto al de producción; staging no tiene cron de tasas (se cargan a mano si hace falta).
CRON_SECRET=PEGA_AQUI_OTRO_SECRETO
UPLOAD_DIR=/app/uploads

# ───── Solo para docker compose (archivo .env, NO .env.staging) ─────
# En /opt/inventory_staging/.env van estas dos:
#   STAGING_DB_PASSWORD=una_clave_larga
#   STAGING_PG_IMAGE=postgres:16-alpine     # misma versión mayor que `docker exec inventory_db_ve postgres -V`
