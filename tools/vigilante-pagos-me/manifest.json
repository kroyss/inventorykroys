{
  "manifest_version": 3,
  "name": "Pagos MercadoEnvíos · El Comerciante Digital",
  "version": "1.3.0",
  "description": "Trae a tu sistema los pagos y guías del portal de MercadoEnvíos con tu propia sesión. Solo lee, no cambia nada.",
  "permissions": ["alarms", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.mercadoenvios.com.ve/*",
    "https://app.elcomerciantedigital.com/*",
    "https://staging.elcomerciantedigital.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "opciones.html",
  "action": { "default_title": "Pagos MercadoEnvíos", "default_popup": "opciones.html" }
}
