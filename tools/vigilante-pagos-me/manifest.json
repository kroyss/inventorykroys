{
  "manifest_version": 3,
  "name": "El Comerciante Digital · Asistente de envíos",
  "short_name": "Asistente de envíos",
  "version": "1.3.4",
  "description": "Trae a El Comerciante Digital los pagos y guías de tu portal de MercadoEnvíos, con tu propia sesión. Solo lee.",
  "icons": { "16": "iconos/icono16.png", "32": "iconos/icono32.png", "48": "iconos/icono48.png", "128": "iconos/icono128.png" },
  "permissions": ["alarms", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.mercadoenvios.com.ve/*",
    "https://app.elcomerciantedigital.com/*",
    "https://staging.elcomerciantedigital.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "opciones.html",
  "action": {
    "default_title": "Asistente de envíos",
    "default_popup": "opciones.html",
    "default_icon": { "16": "iconos/icono16.png", "32": "iconos/icono32.png" }
  }
}
