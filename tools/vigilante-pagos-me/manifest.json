{
  "manifest_version": 3,
  "name": "Vigilante Pagos MercadoEnvíos",
  "version": "1.1.0",
  "description": "Uso interno El Comerciante Digital: trae pagos y guías del portal de MercadoEnvíos cuando se pide desde el sistema.",
  "permissions": ["alarms", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.mercadoenvios.com.ve/*",
    "https://app.elcomerciantedigital.com/*",
    "https://staging.elcomerciantedigital.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "opciones.html",
  "action": { "default_title": "Vigilante Pagos ME", "default_popup": "opciones.html" }
}
